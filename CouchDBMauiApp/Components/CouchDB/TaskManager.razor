@page "/tasks"
@using CouchDBMauiApp.Models.CouchDB
@using CouchDBMauiApp.Services.CouchDB
@inject ITaskRepository TaskRepository
@inject ICouchDbSyncService SyncService
@inject IJSRuntime JSRuntime

<PageTitle>Task Manager - CouchDB Sync</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Task Manager</h1>
                <div class="d-flex gap-2">
                    <button class="btn btn-success" @onclick="OpenAddTaskModal">
                        <i class="fas fa-plus"></i> Add Task
                    </button>
                    <button class="btn @GetSyncButtonClass()" @onclick="ToggleSync" disabled="@(_syncStatus == SyncStatus.Syncing)">
                        <i class="fas @GetSyncIcon()"></i> @GetSyncText()
                    </button>
                </div>
            </div>

            <!-- Sync Status Panel -->
            <div class="alert @GetSyncAlertClass() mb-4" role="alert">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Sync Status:</strong> @_syncMessage
                        @if (_lastSyncTime != DateTime.MinValue)
                        {
                            <br><small>Last sync: @_lastSyncTime.ToString("yyyy-MM-dd HH:mm:ss")</small>
                        }
                        @if (_syncStatus == SyncStatus.Error)
                        {
                            <br><small class="text-muted">📱 Working offline - tasks will sync when CouchDB is available</small>
                        }
                    </div>
                    @if (_conflicts.Any())
                    {
                        <button class="btn btn-warning btn-sm" @onclick="ShowConflicts">
                            <i class="fas fa-exclamation-triangle"></i> @_conflicts.Count Conflicts
                        </button>
                    }
                </div>
            </div>

            <!-- Search and Filter -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search tasks..." 
                               @bind="_searchTerm" @oninput="OnSearchChanged" />
                        <button class="btn btn-outline-secondary" @onclick="SearchTasks">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="FilterStatus">
                        <option value="">All Tasks</option>
                        <option value="false">Pending</option>
                        <option value="true">Completed</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="FilterPriority">
                        <option value="">All Priorities</option>
                        <option value="@((int)TaskPriority.Low)">Low</option>
                        <option value="@((int)TaskPriority.Medium)">Medium</option>
                        <option value="@((int)TaskPriority.High)">High</option>
                        <option value="@((int)TaskPriority.Critical)">Critical</option>
                    </select>
                </div>
            </div>

            <!-- Task Statistics -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">Total Tasks</h5>
                            <h3>@_tasks.Count</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">Completed</h5>
                            <h3>@_tasks.Count(t => t.Completed)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <h5 class="card-title">Pending</h5>
                            <h3>@_tasks.Count(t => !t.Completed)</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <h5 class="card-title">High Priority</h5>
                            <h3>@_tasks.Count(t => t.Priority >= TaskPriority.High)</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tasks List -->
            <div class="row">
                @if (_loading)
                {
                    <div class="col-12 text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading tasks...</p>
                    </div>
                }
                else if (!_filteredTasks.Any())
                {
                    <div class="col-12 text-center">
                        <div class="alert alert-info">
                            <h4>No tasks found</h4>
                            <p>@(_searchTerm.Any() ? "Try adjusting your search criteria." : "Start by adding your first task!")</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var task in _filteredTasks)
                    {
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card h-100 @(task.Completed ? "border-success" : GetPriorityBorderClass(task.Priority))">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" 
                                               checked="@task.Completed" 
                                               @onchange="(e) => ToggleTaskCompletion(task, (bool)e.Value!)" />
                                        <label class="form-check-label fw-bold @(task.Completed ? "text-decoration-line-through text-muted" : "")">
                                            @task.Title
                                        </label>
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="#" @onclick="() => EditTask(task)">
                                                <i class="fas fa-edit"></i> Edit
                                            </a></li>
                                            <li><a class="dropdown-item text-danger" href="#" @onclick="() => DeleteTask(task)">
                                                <i class="fas fa-trash"></i> Delete
                                            </a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <p class="card-text @(task.Completed ? "text-muted" : "")">@task.Description</p>
                                    <div class="mb-2">
                                        <span class="badge @GetPriorityBadgeClass(task.Priority)">
                                            @task.Priority.ToString()
                                        </span>
                                        @if (task.DueDate.HasValue)
                                        {
                                            <span class="badge @(task.DueDate < DateTime.Now ? "bg-danger" : "bg-info") ms-1">
                                                Due: @task.DueDate.Value.ToString("MMM dd")
                                            </span>
                                        }
                                    </div>
                                    @if (task.Tags.Any())
                                    {
                                        <div class="mb-2">
                                            @foreach (var tag in task.Tags)
                                            {
                                                <span class="badge bg-secondary me-1">@tag</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="card-footer text-muted">
                                    <small>
                                        Updated: @task.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </small>
                                    @if (!string.IsNullOrEmpty(task.DeviceId))
                                    {
                                        <br /><small>Device: @task.DeviceId</small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Task Modal -->
<div class="modal fade" id="taskModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(_editingTask?.Id != null ? "Edit Task" : "Add New Task")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form @onsubmit="SaveTask" @onsubmit:preventDefault="true">
                    <div class="mb-3">
                        <label class="form-label">Title *</label>
                        <input type="text" class="form-control" @bind="_editingTask!.Title" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" rows="3" @bind="_editingTask!.Description"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Priority</label>
                            <select class="form-select" @bind="_editingTask!.Priority">
                                <option value="@TaskPriority.Low">Low</option>
                                <option value="@TaskPriority.Medium">Medium</option>
                                <option value="@TaskPriority.High">High</option>
                                <option value="@TaskPriority.Critical">Critical</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Due Date</label>
                            <input type="datetime-local" class="form-control" 
                                   value="@(_editingTask!.DueDate?.ToString("yyyy-MM-ddTHH:mm"))"
                                   @onchange="OnDueDateChanged" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tags (comma-separated)</label>
                        <input type="text" class="form-control" @bind="_tagsInput" 
                               placeholder="work, urgent, meeting" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assigned To</label>
                        <input type="text" class="form-control" @bind="_editingTask!.AssignedTo" 
                               placeholder="person@example.com" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveTask">
                    @(_editingTask?.Id != null ? "Update" : "Create") Task
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Conflicts Modal -->
<div class="modal fade" id="conflictsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Synchronization Conflicts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (_conflicts.Any())
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Conflicts detected!</strong> The following documents have conflicting versions that need to be resolved.
                    </div>
                    
                    @foreach (var conflict in _conflicts)
                    {
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Document: @conflict.DocumentId</h6>
                                <small class="text-muted">Detected: @conflict.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                            </div>
                            <div class="card-body">
                                <p><strong>Conflicting Revisions:</strong></p>
                                <ul class="list-group list-group-flush">
                                    @foreach (var revision in conflict.ConflictingRevisions)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <code>@revision</code>
                                            <button class="btn btn-sm btn-success" 
                                                    @onclick="() => ResolveConflict(conflict.DocumentId, revision)">
                                                Choose This Version
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle"></i> No conflicts detected.
                    </div>
                }
            </div>
        </div>
    </div>
</div>